# Append to ~/.hermes/.env on the Hermes server (do NOT commit real values)
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1   # loopback if the proxy (tailscale funnel) runs on the same machine;
                            # 0.0.0.0 when Hermes is in a container and the proxy is on the host
API_SERVER_PORT=8642
API_SERVER_KEY=<generate: openssl rand -hex 32>

# To serve several profiles (bots) from this one listener, add to ~/.hermes/config.yaml:
#   gateway:
#     multiplex_profiles: true
# Each profile is then reached at /p/<profile>/... and needs its OWN API_SERVER_KEY in
# ~/.hermes/profiles/<profile>/.env (the default key is rejected on /p/<name>/ prefixes).
